# TINARA - Migration URLs .html vers URLs propres en dossiers
# Exemple : /parrainage.html -> /parrainage/

Options -Indexes
RewriteEngine On

# Ne pas rediriger les fichiers techniques inclus par JS
RewriteRule ^(header|footer)\.html$ - [L]

# Accueil : /index.html -> /
RewriteRule ^index\.html$ / [R=301,L]

# Pages internes : /page.html -> /page/
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[?\s]
RewriteRule ^(.+)\.html$ /$1/ [R=301,L]